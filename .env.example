# Komogentic's settings for `docker compose`. Copy to .env and fill in. The README's configuration table says what
# each one does.

# Required. The address Komogentic reaches Komodo Core at, from inside its container: scheme, host and port, no
# path. Prefer an internal Docker network (the API secret travels in every request's headers); plain http only there.
KOMOGENTIC_KOMODO_URL=http://komodo-core:9120

# Recommended. The address people and apps reach Komogentic at: scheme, host and port, no path. Connection URLs,
# the OAuth metadata and the sign-in's Origin check are built from it. Behind compose.traefik.yaml it is
# https://${KOMOGENTIC_HOST} and this line is not used.
KOMOGENTIC_PUBLIC_URL=https://komogentic.example.org

# Optional. Seconds Komogentic waits for one Komodo request (default 30).
# KOMOGENTIC_KOMODO_TIMEOUT_SECONDS=30

# Optional. Lifetime of an app connection's access token in minutes (default 60, 5 to 1440). Shorter means more
# refreshes; claude.ai shows 'Reconnect' if a refresh fails.
# KOMOGENTIC_OAUTH_ACCESS_TOKEN_MINUTES=60

# Optional. Host port the server is published on, localhost only (default 8080).
# KOMOGENTIC_PORT=8080

# Optional. true when a reverse proxy in front of Komogentic sets X-Forwarded-For and X-Forwarded-Proto and is the
# only way in (compose.traefik.yaml sets it). Never true with the port reachable from elsewhere: anyone could then
# choose the address the rate limits count.
# KOMOGENTIC_TRUSTED_PROXY=false

# Optional. Log level: Trace, Debug, Information (default), Warning, Error.
# KOMOGENTIC_LOG_LEVEL=Information

# Optional. Image to run (default ghcr.io/symphonic-navigator/komogentic:latest); pin a version with :0.1.0.
# KOMOGENTIC_IMAGE=ghcr.io/symphonic-navigator/komogentic:0.1.0

# Optional. MongoDB image (default mongo:8).
# KOMOGENTIC_MONGO_IMAGE=mongo:8

# compose.traefik.yaml only. The host name Komogentic is reached at, its DNS record pointing at this host.
# KOMOGENTIC_HOST=komogentic.example.org

# compose.traefik.yaml only. Optional contact for Let's Encrypt's expiry notices.
# KOMOGENTIC_ACME_EMAIL=ops@komogentic.example.org

# compose.traefik.yaml only. Optional: Let's Encrypt's staging server for a trial, so a mistake doesn't hit the
# production rate limits.
# KOMOGENTIC_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# compose.traefik.yaml only. Optional Traefik image (default traefik:v3.7).
# KOMOGENTIC_TRAEFIK_IMAGE=traefik:v3.7

# Optional. Time zone of the log's timestamps (default UTC).
# TZ=UTC
